    "build-storybook": "storybook build",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "build:embed": "vite build --config vite.embed.config.ts && vite build --config vite.embed-iframe.config.ts",
    "build:mf": "vite build --config vite.mf.config.ts"
  },
