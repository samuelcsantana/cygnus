# Production API. Baked into the bundle at build time by Vite — changing it means
# a rebuild, not a restart. Shares `samuelsantana.dev` with the frontend on
# purpose: the auth cookies are SameSite=Strict, so an API on a different
# registrable domain would have login succeed and every request after it 401.
VITE_API_BASE_URL=https://api.cygnus.samuelsantana.dev
# Sentry DSN. Committed on purpose: a DSN is not a credential — it is compiled
# into the client bundle and visible to every visitor by design. It only allows
# *sending* events to this project, never reading them. The secret that does not
# belong here is the auth token used to upload source maps.
VITE_SENTRY_DSN=https://c3065e2f0f8ccf0c18c9d070e13ad0ce@o325983.ingest.us.sentry.io/4511938153611264
